{
  "name": "bhashabridge",
  "displayName": "BhashaBridge",
  "description": "Read LLM explanations in your own language. Code stays in English.",
  "version": "0.0.1",
  "publisher": "bhashabridge",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bhashabridge.translate",
        "title": "BhashaBridge: Translate LLM Output"
      },
      {
        "command": "bhashabridge.translateSelection",
        "title": "BhashaBridge: Translate Selection"
      },
      {
        "command": "bhashabridge.setSarvamApiKey",
        "title": "BhashaBridge: Set Sarvam API Key"
      },
      {
        "command": "bhashabridge.clearSarvamApiKey",
        "title": "BhashaBridge: Clear Sarvam API Key"
      },
      {
        "command": "bhashabridge.chooseGlossaryDomains",
        "title": "BhashaBridge: Choose Glossary Domains"
      },
      {
        "command": "bhashabridge.createWorkspaceGlossary",
        "title": "BhashaBridge: Create Workspace Glossary"
      },
      {
        "command": "bhashabridge.clearTranslationCache",
        "title": "BhashaBridge: Clear Translation Cache"
      }
    ],
    "configuration": {
      "title": "BhashaBridge",
      "properties": {
        "bhashabridge.defaultLanguage": {
          "type": "string",
          "enum": [
            "gu",
            "mr"
          ],
          "enumItemLabels": [
            "Gujarati",
            "Marathi"
          ],
          "default": "gu",
          "description": "Language the BhashaBridge panel translates into when it opens."
        },
        "bhashabridge.defaultProvider": {
          "type": "string",
          "enum": [
            "sarvam",
            "vscode-lm"
          ],
          "enumItemLabels": [
            "Sarvam AI",
            "VS Code model (Copilot)"
          ],
          "default": "sarvam",
          "description": "Translation provider the BhashaBridge panel and @bhashabridge chat use. \"VS Code model\" needs GitHub Copilot; without it, Sarvam AI is used."
        },
        "bhashabridge.glossaryDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "software-core",
              "web-frontend",
              "backend-apis",
              "databases",
              "cloud-devops",
              "security",
              "data-ai",
              "mobile",
              "testing-qa",
              "version-control",
              "networking",
              "agile-project",
              "embedded-iot",
              "game-dev",
              "blockchain",
              "supply-chain-logistics",
              "healthcare",
              "finance-banking",
              "insurance",
              "ecommerce-retail",
              "education",
              "manufacturing",
              "government-public",
              "telecom",
              "hr-payroll",
              "marketing-sales",
              "legal-compliance",
              "real-estate",
              "agriculture",
              "energy-utilities",
              "travel-hospitality",
              "media-entertainment"
            ],
            "enumDescriptions": [
              "Programming fundamentals",
              "Web and frontend",
              "Backend and APIs",
              "Databases",
              "Cloud and DevOps",
              "Security",
              "Data, AI and machine learning",
              "Mobile apps",
              "Testing and QA",
              "Version control",
              "Networking",
              "Agile and project management",
              "Embedded and IoT",
              "Game development",
              "Blockchain and Web3",
              "Supply chain and logistics",
              "Healthcare",
              "Finance and banking",
              "Insurance",
              "E-commerce and retail",
              "Education and EdTech",
              "Manufacturing",
              "Government and public services",
              "Telecom",
              "HR and payroll",
              "Marketing and sales",
              "Legal and compliance",
              "Real estate",
              "Agriculture and AgriTech",
              "Energy and utilities",
              "Travel and hospitality",
              "Media and entertainment"
            ]
          },
          "uniqueItems": true,
          "default": [
            "software-core",
            "web-frontend",
            "backend-apis",
            "databases",
            "cloud-devops",
            "security",
            "data-ai",
            "mobile",
            "testing-qa",
            "version-control",
            "networking",
            "agile-project",
            "embedded-iot",
            "game-dev",
            "blockchain"
          ],
          "markdownDescription": "Glossary domains whose terms always stay in English. Software development domains are on by default; turn on business domains if you build software for them. Easiest to change with **BhashaBridge: Choose Glossary Domains**."
        },
        "bhashabridge.workspaceGlossaryPath": {
          "type": "string",
          "default": ".bhashabridge/glossary.json",
          "scope": "resource",
          "markdownDescription": "Your project's own glossary file, relative to the workspace folder. Its terms win over the built-in glossary. Create one with **BhashaBridge: Create Workspace Glossary**."
        }
      }
    },
    "keybindings": [
      {
        "command": "bhashabridge.translateSelection",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "editorTextFocus && editorHasSelection",
        "args": {
          "source": "editor"
        }
      },
      {
        "command": "bhashabridge.translateSelection",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "terminalFocus",
        "args": {
          "source": "terminal"
        }
      },
      {
        "command": "bhashabridge.translateSelection",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "!(editorTextFocus && editorHasSelection) && !terminalFocus",
        "args": {
          "source": "clipboard"
        }
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "bhashabridge.translateSelection",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "bhashabridge.chat",
        "name": "bhashabridge",
        "fullName": "BhashaBridge",
        "description": "Answer or translate in Gujarati or Marathi, with code kept in English",
        "isSticky": true,
        "commands": [
          {
            "name": "translate",
            "description": "Translate text you already have, keeping code in English"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js",
    "test:unit": "vitest run --dir test/unit",
    "glossary:review": "node scripts/glossary-review.mjs",
    "quality": "npm run compile && node scripts/quality.mjs"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-hast": "^13.2.1"
  },
  "activationEvents": [
    "onChatParticipant:bhashabridge.chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SkayKapadia/bhashabridge"
  },
  "bugs": {
    "url": "https://github.com/SkayKapadia/bhashabridge/issues"
  }
}
